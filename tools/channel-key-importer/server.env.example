CHANNEL_IMPORTER_NO_OPEN=1
CHANNEL_IMPORTER_PORT=4179
DATAEYESAI_PUBLIC_PORT=4179
DATAEYESAI_HOST=0.0.0.0
DATAEYESAI_STORAGE=sqlite
DATAEYESAI_DATA_DIR=/data
DATAEYESAI_DATABASE_PATH=/data/dataeyesai.sqlite

# Exact Host header accepted by the app. Include the external port.
DATAEYESAI_PUBLIC_HOSTS=your-server.example:4179
# Exact browser Origin accepted for write requests.
DATAEYESAI_PUBLIC_ORIGINS=http://your-server.example:4179

# Generate with: node src/generateAccessKey.js
# Store only the hash here. Keep the one-time accessKey separately.
DATAEYESAI_ACCESS_KEY_HASH=scrypt:v1:replace-with-generated-hash

# Generate with: openssl rand -base64 32
# This encrypts remembered New API system tokens in SQLite.
DATAEYESAI_MASTER_KEY=replace-with-32-byte-base64-key

# Set to 1 only when the external URL uses HTTPS.
DATAEYESAI_SECURE_COOKIE=0
