Windows Registry Editor Version 5.00

; Allow the self-updating All API Hub CRX to install and update itself.
; Trust scope: release-assets.githubusercontent.com serves other repositories.
; Both CRX and referrer must match; this does not restrict installs to one ID.
; Read README.md before importing and merge existing policies with your admin.
; The id below is the All API Hub self-update CRX id; it must match the
; "appid" in the release's updates.xml. Verify it on chrome://extensions after
; installing.
;
; HKEY_LOCAL_MACHINE requires an administrator shell. These are mandatory
; policies: user-level edits (HKCU) are ignored by policy-aware Chrome/Edge.
;
; Edge users replace "Google\Chrome" with "Microsoft\Edge" in both keys.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallAllowlist]
"1"="oligofghjlogjhmnhnhccnobbginfgmp"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallSources]
"1"="https://github.com/qixing-jk/all-api-hub/*"
"2"="https://release-assets.githubusercontent.com/*"
